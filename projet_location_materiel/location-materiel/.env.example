# Copiez ce fichier en .env et adaptez les valeurs
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=location_materiel

# Clé secrète pour signer les jetons de connexion (changez-la !)
JWT_SECRET=changez_cette_cle_secrete
JWT_EXPIRES_IN=8h

# Délai (en minutes) pendant lequel une demande validée bloque le matériel en attendant le paiement
PAIEMENT_DELAI_MINUTES=30

# Pénalité de retard = tarif journalier x quantité x jours de retard x ce multiplicateur
PENALITE_MULTIPLICATEUR_RETARD=1.5

